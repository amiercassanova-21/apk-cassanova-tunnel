<?xml version="1.0" encoding="utf-8"?>
<!-- Cassanova: SSH passwords, configs (MMKV) and the connection log must not leave the phone
     through Google backup or device-to-device transfer. Use the app's own Backup screen instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
